# If themes are missing in your choice of package source, run:
# cd (mktemp -d)
# git clone --depth 1 --single-branch https://github.com/mbadolato/iTerm2-Color-Schemes.git
# mkdir -p ~/.config/ghostty/themes
# cp iTerm2-Color-Schemes/ghostty/* ~/.config/ghostty/themes/
# rm -fr iTerm2-Color-Schemes
theme = dark:Breeze,light:Catppuccin Latte
font-size = 11
window-inherit-working-directory = true
tab-inherit-working-directory = true
split-inherit-working-directory = true
notify-on-command-finish = unfocused
notify-on-command-finish-action = no-bell,notify
