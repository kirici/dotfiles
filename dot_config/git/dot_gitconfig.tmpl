[user]
	name = {{ .name | quote }}
	email = {{ .email | quote }}
	signingKey = "~/.ssh/{{ .sshkey }}"
[fetch]
	prune = true
[core]
	pager = bat -p
[gpg]
	format = ssh
[init]
	defaultBranch = master
[commit]
	gpgsign = true
[gpg "ssh"]
	allowedSignersFile = "~/.config/git/allowed_signers"
[rerere]
	enabled = true
[diff]
  external = difft
